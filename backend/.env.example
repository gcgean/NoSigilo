PORT=4001
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_FILE=./data/nosigilo.sqlite
JWT_SECRET=change-me
SEED_DEMO=true
TRIAL_DAYS=30
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_NAME=NoSigilo
HUB_BILLING_BASE_URL=
HUB_BILLING_API_KEY=
HUB_BILLING_ADMIN_EMAIL=
HUB_BILLING_ADMIN_PASSWORD=
HUB_BILLING_PRODUCT_ID=
HUB_BILLING_WEBHOOK_SECRET=

# ─── Web Push (notificações push no celular) ───────────────────────────────
# OBRIGATÓRIO em produção. Sem estas variáveis, chaves efêmeras são geradas
# a cada restart do servidor, invalidando todas as subscriptions dos usuários.
#
# Para gerar um par de chaves VAPID:
#   npx web-push generate-vapid-keys
#
# VAPID_SUBJECT deve ser uma URL https:// do seu domínio ou mailto:
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@nosigilo.net
